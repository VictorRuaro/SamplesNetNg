@section Styles {

    @Styles.Render("~/bundles/datetimepickerCss")

}
@section Scripts {
    @Scripts.Render("~/bundles/filestyle")
    @Scripts.Render("~/bundles/moment")
    @Scripts.Render("~/bundles/datetimepicker")

<script type="text/javascript">

    $().ready(function () {
        $("#Certificado_FechaCaducidad").addClass("validaFechaFinal");
        DefineValidationRules();
    })


    function DefineValidationRules() {
        $.validator.addMethod("greaterStart", function (value, element, params) {

    
            //var startDate = $(params).val();//toma el valor de la fecha de caducidad anterior

            //var fi_valida = moment(startDate, 'DD/MM/YYYY', true).isValid();
            //var ff_valida = moment(value, 'DD/MM/YYYY', true).isValid();

            //if (fi_valida && ff_valida) {
                
            //    var fi = moment(startDate, 'DD/MM/YYYY', true).toDate();
            //    var ff = moment(value, 'DD/MM/YYYY', true).toDate();

            //}
            //else {
            //    return false;
            //}

            
            var ff_valida = moment(value, 'DD/MM/YYYY', true).isValid();

            if (ff_valida) {

                var fi = moment().toDate();
                var ff = moment(value, 'DD/MM/YYYY', true).toDate();

            }
            else {
                return false;
            }

            //console.log(moment(startDate, 'DD/MM/YYYY').toDate() + '<=' + moment(value, 'DD/MM/YYYY').toDate())

            return fi <= ff || value == "";
        }, "La Nueva Fecha de Caducidad debe ser mayor a la Fecha Actual");


        jQuery.validator.addClassRules({
            validaFechaFinal: {
                required: true,
                greaterStart: "#FechaCaducidad"
            }
        });
    }

    $(function () {
        $.validator.methods.date = function (value, element) {
            return this.optional(element) || moment(value, 'DD/MM/YYYY', true).isValid();
        };
    });

    $(document).on('change', ':file', function () {
        //debugger
        var input = $(this),
            numFiles = input.get(0).files ? input.get(0).files.length : 1,
            label = input.val().replace(/\\/g, '/').replace(/.*\//, '');
        var maxSize = input.data('max-size')*1024;

        var msgval=$('.filevalid');
        $(msgval).html('');

        var existClass = $('div[id^="writeFechaCaducidad"]').hasClass('hidden');

        if (existClass != true) {

            $('div[id^="writeFechaCaducidad"]').addClass('hidden');
        }

        if (input.get(0).files.length) {
            var fileSize = input.get(0).files[0].size; // in bytes

            if (fileSize > maxSize) {
                $(msgval).html('El tamaño maximo del archivo es de ' + (maxSize/1024) + ' KB');
                input.val('');

            } else {
                
                $('div[id^="writeFechaCaducidad"]').removeClass('hidden');
            }

        } else {
            $(msgval).html('Seleccione un archivo con un tamaño maximo de ' + (maxSize / 1024) + ' KB');

        }
        
    });

</script>

}