@section Styles {


    <link href="@Styles.Url("~/Content/bootstrap-datetimepicker.css")" rel="stylesheet" type="text/css" />
}
@section Scripts {

    @Scripts.Render("~/bundles/chosen")
    @Scripts.Render("~/bundles/moment")
    @Scripts.Render("~/bundles/datetimepicker")

    <script type="text/javascript">

        $(function () {
            $.validator.methods.date = function (value, element) {
                return this.optional(element) || moment(value, 'DD/MM/YYYY', true).isValid();
            };
        });

        $(".chosen-select").chosen({ no_results_text: "Resultados no encontrados para:" });
        $("#idSustanciaMaterial").change(function () {

            var value = $(this).val();
            var url = "@Url.Action("DatosSustancia", "DevolucionSustancias")";
            $.get(url, { idSustancia: value })
                .success(
                    function (data) {

                        if (data.informacion == null) {

                            //debugger;
                            $('div[id="Codigo"]').html(data.Codigo);
                            $('div[id="CAS"]').html(data.CAS);
                            $('div[id="PMCompuesto"]').html(data.PMCompuesto);
                            $('div[id="FormulaMolecular"]').html(data.FormulaMolecular);
                            $('div[id="GrupoFarmacologico"]').html(data.GrupoFarmacologico);
                            $('div[id="colorHtml"] > span').attr('style', 'color:' + data.colorHtml);
                            $('div[id="EsSustanciaControlada"]').html(data.EsSustanciaControlada);
                            

                            var Lotes = data.Lotes;
                            $('div[id="DatosLote"]').empty();
                            LoadDDLField('#idAlmacen', Lotes);
                        }
                        else {

                            $("#lblInformacion").html(data.informacion);
                        }

                        //$('.ibox-content').toggleClass('sk-loading');

                    }
                ).fail(function (jqXHR, textStatus, errorThrown) {

                    //$('.ibox-content').toggleClass('sk-loading');
                });

        });

        $("#idAlmacen").change(function () {

            $('div[id="DatosLote"]').empty();
            var idAlmacen = $(this).val();
            if (idAlmacen > 0) {

                $('.ibox-content').toggleClass('sk-loading');

                //$('input[name="idAlmacen"]').val(idAlmacen);

                var url = "@Url.Action("DatosLoteSustancia", "DevolucionSustancias")";
                $.post(url, { idAlmacen: idAlmacen })
                    .success(
                        function (result) {
                            
                            if (result != null) {
                                $('div[id="DatosLote"]').html(result);
                            }
                            else {

                                $("#lblInformacion").html("");
                            }
                        }
                    ).fail(function (jqXHR, textStatus, errorThrown) {

                        $('.ibox-content').toggleClass('sk-loading');
                    }).complete(function () {
                        $('.ibox-content').toggleClass('sk-loading');
                    })
            }
        });

        function LoadDDLField(DDLListId, FieldJSONList) {
            $(DDLListId).empty();
            $(DDLListId).append($('<option />', {
                value: "",
                text: "--Seleccione una opcion--"
            }));
            $.each(FieldJSONList, function (i, item) {
                $(DDLListId).append($('<option />', {
                    value: item.value,
                    text: item.text
                }));
            });
        }
    </script>
}
