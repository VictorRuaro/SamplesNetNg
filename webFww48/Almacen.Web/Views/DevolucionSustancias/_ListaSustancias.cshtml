@using Almacen.Web.ViewModels.Catalogos

@model IEnumerable<SustanciaVM>

<div class="panel panel-default">
    <div class="table-responsive">

        <table class="table table-hover table-condensed " id="table">
            <thead class="">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Codigo)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Descripcion)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.cGrupoFarmacologico.color)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.cGrupoFarmacologico.GrupoFarmacologico)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Sinonimos)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.CAS)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.PMCompuesto)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.FormulaMolecular)
                    </th>
                    <th class=""></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null)
                {
                    <tr>
                        <td colspan="8">
                            <div class="alert alert-warning"><i class="fa fa-warning mr"></i><strong>No se han ingresado datos</strong></div>
                        </td>
                    </tr>

                }
                else if (Model.Count() == 0)
                {
                    <tr>
                        <td colspan="8">
                            <div class="alert alert-info"><i class="fa fa-warning mr"></i><strong>No se encontraron datos con los filtros ingresados</strong></div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Codigo)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Descripcion)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cGrupoFarmacologico.colorHtml)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cGrupoFarmacologico.GrupoFarmacologico)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Sinonimos)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.CAS)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.PMCompuesto)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.FormulaMolecular)
                            </td>
                            <td class="td-actions text-right">
                                <a title="" class="btn  btn-primary" href="@Url.Action("Create", null, new { idSustanciaMaterial = item.idSustanciaMaterial })" data-original-title="Agregar">
                                    Agregar
                                </a>
                                <a title="" class="btn  btn-link" href="@Url.Action("Existencias", null, new { idSustanciaMaterial = item.idSustanciaMaterial })" data-original-title="Existencias">
                                    Existencias
                                </a>
                                @*<a title="" class="btn  btn-link" href="@Url.Action("Delete", null, new { id = item.idSustanciaMaterial })" data-original-title="Eliminar">
                                    Baja
                                </a>*@
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>

</div>
