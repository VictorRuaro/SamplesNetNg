@using Almacen.Web.ViewModels.Catalogos

@model IEnumerable<GrupoFarmacologicoVM>

<div class="panel panel-default">
    <div class="table-responsive">

        <table class="table table-hover table-condensed " id="table">
            <thead class="">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.GrupoFarmacologico)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.colorHtml)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.color)
                    </th>
                    <th class=""></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null)
                {
                    <tr>
                        <td colspan="2">
                            <div class="alert alert-warning"><i class="fa fa-warning mr"></i><strong>No se han ingresado datos</strong></div>
                        </td>
                    </tr>

                }
                else if (Model.Count() == 0)
                {
                    <tr>
                        <td colspan="2">
                            <div class="alert alert-warning"><i class="fa fa-warning mr"></i><strong>No se han ingresado datos</strong></div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.GrupoFarmacologico)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.colorHtml)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.color)
                            </td>

                            <td class="td-actions text-right">

                                <a title="" class="btn  btn-link" href="@Url.Action("Details", null, new { id = item.idGrupoFarmacologico })" data-original-title="Detalle">
                                    Detalle
                                </a>
                                <a title="" class="btn  btn-link" href="@Url.Action("Edit", null, new { id = item.idGrupoFarmacologico })" data-original-title="Editar">
                                    Editar
                                </a>
                                <a title="" class="btn  btn-link" href="@Url.Action("Delete", null, new { id = item.idGrupoFarmacologico })" data-original-title="Eliminar">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>

</div>
