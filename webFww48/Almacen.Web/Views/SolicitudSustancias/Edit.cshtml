@section Styles {
    @*@Styles.Render("~/bundles/datatablesCss")*@
}
@section Scripts {
    @*@Scripts.Render("~/bundles/datatables")*@


    <script type="text/javascript">

        $().ready(function () {

        $("#btnModalBuscarSustancia").click(
            function () {

                var msg=$("#msgModal");
                msgModalInit(msg);

                var Codigo = $('input[id="Codigo"]').val();
                var Descripcion = $('input[id="DescripcionBuscar"]').val();
                var Sinonimos = $('input[id="Sinonimos"]').val();
                var idGrupoFarmacologico = $('select[id="idGrupoFarmacologico"]').val();
                var EsSustanciaControlada = $('select[id="EsSustanciaControlada"]').val();

                var CAS = $('input[id="CAS"]').val();
                var PMCompuesto = $('input[id="PMCompuesto"]').val();
                var FormulaMolecular = $('input[id="FormulaMolecular"]').val();
        
                var url = $(this).attr('data-actionurl');

                if (url.length > 0) {

                    $('div[id="resultadosBusqueda"]').toggleClass('sk-loading');

                    $.get(url, { Codigo: Codigo, Descripcion: Descripcion, Sinonimos: Sinonimos, idGrupoFarmacologico: idGrupoFarmacologico, EsSustanciaControlada: EsSustanciaControlada, CAS: CAS, PMCompuesto: PMCompuesto, FormulaMolecular: FormulaMolecular })
                        .success(
                            function (result) {

                                if (result !== null) {

                                    $('div[id="resultadosBusqueda"]').html(result);

                                }
                                else {

                                    $("#lblInformacionModal").html("");
                                }

                                $('div[id="resultadosBusqueda"]').toggleClass('sk-loading');

                            }
                        )
                        //.fail(function () {
                        //    debugger
                        //    //$("#lblInformacionModal").html("Error al conectarse");
                        //    $('.ibox-content').toggleClass('sk-loading');
                        //});
                    .error(function (jqXHR, textStatus, errorThrown) {
                        $('div[id="resultadosBusqueda"]').toggleClass('sk-loading');
                        //debugger
                    });


                } else {
                    $("#lblInformacionModal").html("Complete todos los campos");
                }

                return false;

            });

        //Seleccionar sustancias

        $("#btnSelecionarSustancias").click(
            function () {

                var idEstatusSolicitud = $('input[name="idEstatusSolicitud"').val();

                var selected = [];
                $('input[name="Selecciona"').each(function () {
                    if ($(this).is(":checked")) {
                        selected.push($(this).val());
                    }
                });

                //valida que solo se seleccione un elemento
                var msg=$("#msgModal");
                msgModalInit(msg);


                if(selected.length==0)
                {

                    $(msg).html('Seleccione una o mas sustancias');
                    $(msg).addClass('text-danger');
                    return false;
                }

                var listasustancias = [];

                var tabla = $("#tablaListado");


                if($(tabla).length > 0)
                {
                    if (listasustancias.length == 0) {
                        $(tabla).find("tr").each(function (key, value) {
                            //debugger
                            var sustanciam = FindModel(value, key)
                            if (sustanciam != null) {
                                listasustancias.push(sustanciam);

                            }
                        })
                    }
                    else {
                        $.each(listasustancias, function (key, value) {
                            SetModel(value, key)
                        });

                    }
                }


                var url = $(this).attr('data-actionurl');

                if (url.length > 0) {

                    $('#loading').toggleClass('sk-loading');

                    $.post(url, { selecionados: selected, sustancias: listasustancias, idEstatusSolicitud: idEstatusSolicitud })
                        .success(
                            function (result) {

                                if (result !== null) {

                                    $('div[id="ListaSolicitud"]').html(result);

                                }
                                else {

                                    $("#lblInformacionModal").html("");
                                }
                                $('form').data('validator', null);
                                $.validator.unobtrusive.parse($('form'));

                                $('#loading').toggleClass('sk-loading');

                            }
                        )
                        //.fail(function () {
                        //    debugger
                        //    //$("#lblInformacionModal").html("Error al conectarse");
                        //    $('.ibox-content').toggleClass('sk-loading');
                        //});
                    .error(function (jqXHR, textStatus, errorThrown) {
                        $('#loading').toggleClass('sk-loading');
                        //debugger
                    });


                } else {
                    $("#lblInformacionModal").html("Complete todos los campos");
                }

            });

        $(".btnEliminarSustancia").click(
                function () {

                    var idEstatusSolicitud = $('input[name="idEstatusSolicitud"').val();

                    var listasustancias = [];


                    var tabla = $("#tablaListado");


                    if (listasustancias.length == 0) {
                        $(tabla).find("tr").each(function (key, value) {
                            //debugger
                            var sustanciam = FindModel(value, key)
                            if (sustanciam != null) {
                                listasustancias.push(sustanciam);

                            }
                        })
                    }
                    else{
                        $.each( listasustancias, function( key, value ){
                            SetModel(value, key)
                        });

                    }


                    var url = $(this).attr('data-actionurl');
                    var index =$(this).attr('data-id');

                    if (url.length > 0) {

                        $('#loading').toggleClass('sk-loading');

                        $.post(url, { index: index, sustancias: listasustancias, idEstatusSolicitud: idEstatusSolicitud })
                            .success(
                                function (result) {

                                    if (result !== null) {

                                        $('div[id="ListaSolicitud"]').html(result);

                                    }
                                    else {

                                        $("#lblInformacionModal").html("");
                                    }
                                    $('form').data('validator', null);
                                    $.validator.unobtrusive.parse($('form'));

                                    $('#loading').toggleClass('sk-loading');

                                }
                            )
                            //.fail(function () {
                            //    debugger
                            //    //$("#lblInformacionModal").html("Error al conectarse");
                            //    $('.ibox-content').toggleClass('sk-loading');
                            //});
                        .error(function (jqXHR, textStatus, errorThrown) {
                            $('#loading').toggleClass('sk-loading');
                            //debugger
                        });


                    } else {
                        $("#lblInformacionModal").html("Complete todos los campos");
                    }

                });

        $("#btnModalSelecionaPresentacion").click(
        function () {
            //var idEstatusSolicitud = $('input[name="idEstatusSolicitud"').val();

            var selected = [];
            $('input[name="Presentacion"').each(function () {
                if ($(this).is(":checked")) {

                    var existencia = Presentacion(this);
                    selected.push(existencia);
                }
            });

            //valida que solo se seleccione un lote del almacen
            var msg=$("#msgModalPresentacion");
            msgModalInit(msg);


            if(selected.length==0)
            {

                $(msg).html('Seleccione una presentacion');
                $(msg).addClass('text-danger');
                return false;
            }

            if(selected.length>1)
            {

                $(msg).html('Solamente se puede seleccionar una presentacion');
                $(msg).addClass('text-danger');
                return false;
            }

            var listasustancias = [];

            var tabla = $("#tablaListado");


            if ($(tabla).length > 0) {
                if (listasustancias.length == 0) {
                    $(tabla).find("tr").each(function (key, value) {
                        //debugger
                        var sustanciam = FindModel(value, key)
                        if (sustanciam != null) {
                            listasustancias.push(sustanciam);

                        }
                    })
                }
                else {
                    $.each(listasustancias, function (key, value) {
                        SetModel(value, key)
                    });

                }
            }


            var url = $(this).attr('data-actionurl');

            if (url.length > 0) {

                $('#loading').toggleClass('sk-loading');

                $.post(url, { selecionados: selected, sustancias: listasustancias,idEstatusSolicitud:0 })
                    .success(
                        function (result) {

                            if (result !== null) {

                                $('div[id="ListaSolicitud"]').html(result);

                            }
                            else {

                                $("#lblInformacionModal").html("");
                            }

                            var form=$('div[id="ListaSolicitud"]').closest("form");

                            $(form).data('validator', null);
                            $.validator.unobtrusive.parse($(form));

                            $('#loading').toggleClass('sk-loading');

                        }
                    )
                    //.fail(function () {
                    //    debugger
                    //    //$("#lblInformacionModal").html("Error al conectarse");
                    //    $('.ibox-content').toggleClass('sk-loading');
                    //});
                .error(function (jqXHR, textStatus, errorThrown) {
                    $('#loading').toggleClass('sk-loading');
                    debugger
                });


            } else {
                $("#lblInformacionModal").html("Complete todos los campos");
            }
        })

        $(".btnSeleccionaPresentacion").click(
            function () {
                var msg = $("#msgModalPresentacion");
                msgModalInit(msg);

                var url = $(this).attr('data-actionurl');
                var id = $(this).attr('data-id');

                var urlSustancia = '@Url.Action("Sustancia", "DatosAplicacion")';

                $('div[id="resultadoPresentaciones"]').toggleClass('sk-loading');
                //debugger
                $.get(urlSustancia, { idSustanciaMaterial: id })
                        .success(
                            function (result) {

                                if (result !== null) {

                                    $('div[id="datosItem"]').html(result);

                                }
                                else {

                                    $("#lblInformacionModal").html("");
                                }

                            }
                        )
                    .error(function (jqXHR, textStatus, errorThrown) {
                        $('div[id="resultadoPresentaciones"]').toggleClass('sk-loading');
                        //debugger;
                    }).complete(function () {

                        if (url.length > 0) {

                            $.get(url, { idSustanciaMaterial: id })
                                .success(
                                    function (result) {

                                        if (result !== null) {

                                            $('div[id="resultadoPresentaciones"]').html(result);

                                        }
                                        else {

                                            $("#lblInformacionModal").html("");
                                        }
                                    }
                                )
                            .error(function (jqXHR, textStatus, errorThrown) {
                                $('div[id="resultadoPresentaciones"]').toggleClass('sk-loading');
                                //debugger;
                            }).complete(function () {
                                $('div[id="resultadoPresentaciones"]').toggleClass('sk-loading');
                            });

                        }

                    });
            });

    });



    function FindModel(object, row) {

        var result = null;

        var material=@Html.Raw(Json.Encode(new SolicitudDetalleVM()));

        var input = $('input[name="Materiales[' + row + '].idSustanciaMaterial"]');

        if ($(input).length > 0) {


            material.idSolicitudDetalle= $('input[name="Materiales[' + row + '].idSolicitudDetalle"]').val();
            material.idSustanciaMaterial= $('input[name="Materiales[' + row + '].idSustanciaMaterial"]').val();
            material.Descripcion= $('input[name="Materiales[' + row + '].Descripcion"]').val();
            material.CantidadSolicitada= $('input[name="Materiales[' + row + '].CantidadSolicitada"]').val();
            material.CantidadAutorizada= $('input[name="Materiales[' + row + '].CantidadAutorizada"]').val();
            material.CantidadSurtida= $('input[name="Materiales[' + row + '].CantidadSurtida"]').val();
            material.CantidadDevolver= $('input[name="Materiales[' + row + '].CantidadDevolver"]').val();
            material.CantidadDevuelta= $('input[name="Materiales[' + row + '].CantidadDevuelta"]').val();
            material.idTipoEnvase= $('input[name="Materiales[' + row + '].idTipoEnvase"]').val();
            material.idPresentacion= $('input[name="Materiales[' + row + '].idPresentacion"]').val();
            material.idUnidadMedida= $('input[name="Materiales[' + row + '].idUnidadMedida"]').val();
            material.idSolicitudEstatus= $('input[name="Materiales[' + row + '].idSolicitudEstatus"]').val();
