@using Almacen.Web.ViewModels

@model IEnumerable<DevolucionMaterialVM>

<div class="panel panel-default">
    <div class="table-responsive">

        <table class="table table-hover table-condensed " id="table">
            <thead class="">
                <tr>
                    <th class="">@Html.DisplayNameFor(model => model.LoteInterno)</th>
                    @*<th class="">@Html.DisplayNameFor(model => model.NumParte)</th>
                    <th class="">@Html.DisplayNameFor(model => model.NumCatalago)</th>
                    <th class="">@Html.DisplayNameFor(model => model.cMarca.Marca)</th>
                    <th class="">@Html.DisplayNameFor(model => model.cPresentacion.Presentacion)</th>*@
                    <th class="">@Html.DisplayNameFor(model => model.Existencia)</th>
                    <th class="">@Html.DisplayNameFor(model => model.IntegrarAlmacen)</th>
                    @*<th class="">@Html.DisplayNameFor(model => model.FechaRecepcion)</th>
                    <th class="">@Html.DisplayNameFor(model => model.FechaCaducidad)</th>
                    <th class="">@Html.DisplayNameFor(model => model.cCondicionesAlmacenaje.CondicionesAlmacenaje)</th>
                    <th class="">@Html.DisplayNameFor(model => model.LoteProveedor)</th>
                    <th class="">@Html.DisplayNameFor(model => model.cProveedor.Proveedor)</th>*@
                    <th class=""></th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null)
                {
                    <tr>
                        <td colspan="8">
                            <div class="alert alert-warning"><i class="fa fa-warning mr"></i><strong>No se han ingresado datos</strong></div>
                        </td>
                    </tr>

                }
                else if (Model.Count() == 0)
                {
                    <tr>
                        <td colspan="8">
                            <div class="alert alert-info"><i class="fa fa-warning mr"></i><strong>No se encontraron datos con los filtros ingresados</strong></div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.LoteInterno)
                            </td>
                            @*<td class="">
                                @Html.DisplayFor(modelItem => item.NumParte)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.NumCatalago)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cMarca.Marca)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cPresentacion.Presentacion)
                            </td>*@
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Existencia)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.IntegrarAlmacen)
                            </td>
                            @*<td class="">
                                @Html.DisplayFor(modelItem => item.FechaRecepcion)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.FechaCaducidad)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cCondicionesAlmacenaje.CondicionesAlmacenaje)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.LoteProveedor)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cProveedor.Proveedor)
                            </td>*@
                            <td class="td-actions text-right">

                                @*<a title="" class="btn  btn-link" href="@Url.Action("Edit","DevolucionMateriales",new {id= item.idDevolucion})" data-original-title="Editar">
                                    Editar
                                </a>*@
                                <a title="" class="btn  btn-link" href="@Url.Action("Delete","DevolucionMateriales",new {id= item.idDevolucion })" data-original-title="Eliminar">
                                    Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

    </div>

</div>
