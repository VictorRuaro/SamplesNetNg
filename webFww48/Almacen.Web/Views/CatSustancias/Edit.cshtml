                @Html.ValidationMessageFor(model => model.PMCompuesto, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.FormulaMolecular, htmlAttributes: new { @class = "control-label col-md-2" })
