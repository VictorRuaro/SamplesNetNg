                @Html.EditorFor(model => model.FormulaMolecular, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.FormulaMolecular, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.EsSustanciaControlada, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @*<div class="checkbox c-checkbox">
                    <label>
                        <input name="EsSustanciaControlada" id="EsSustanciaControlada" type="checkbox" value="true" @(Model.EsSustanciaControlada?"checked":"")>
                        <span class="fa fa-check bg-white"></span>
                        <input name="EsSustanciaControlada" type="hidden" value="false">
                    </label>
                </div>*@
                @Html.EditorFor(model => model.EsSustanciaControlada, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.EsSustanciaControlada, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input class="btn btn-primary" type="submit" value="Guardar">
            </div>
        </div>
    </div>
}

<div>
    <a href="@Url.Action("Index")" class="btn btn-default text-primary" title="Regresar">
        <i class="fa fa-arrow-left"></i> Regresar
    </a>
</div>