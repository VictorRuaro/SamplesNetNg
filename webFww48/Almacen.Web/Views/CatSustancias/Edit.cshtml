                @Html.ValidationMessageFor(model => model.CAS, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.PMCompuesto, htmlAttributes: new { @class = "control-label col-md-2" })
