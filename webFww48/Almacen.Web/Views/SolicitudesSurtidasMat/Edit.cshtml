
@model Almacen.Web.ViewModels.SolicitudVM
<h3>Surtir</h3>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DisplayFor(model => model.Descripcion)

            </div>
        </div>

        <div class="clearfix mb-lg"></div>

        <div class="form-group">

            @Html.LabelFor(model => model.Materiales, htmlAttributes: new { @class = "control-label col-md-2" })

            <div class="col-md-10">

                <div class="panel panel-default">
                    <div class="panel-heading hidden-xs hidden-sm">
                        <div class="col-md-4">
                            @Html.LabelFor(model => model.Model.Material, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-1">
                            @Html.LabelFor(model => model.Model.CantidadSolicitada, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-1">
                            @Html.LabelFor(model => model.Model.CantidadAutorizada, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-1">
                            @Html.LabelFor(model => model.Model.CantidadSurtida, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-1">
                            @Html.LabelFor(model => model.Model.CantidadDevolver, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-2">
                            @Html.LabelFor(model => model.Model.CantidadDevuelta, htmlAttributes: new { @class = "control-label" })
                        </div>
                        @*<div class="col-md-2">
                            @Html.LabelFor(model => model.Model.UnidadMedida, htmlAttributes: new { @class = "control-label" })
                        </div>*@
                        <div class="col-md-2"></div>

                    </div>

                    <div class="clearfix"></div>

                    <hr class="hidden-xs hidden-sm" />
                    <div class="panel-body">
                        @foreach (var item in Model.Materiales)
                        {
                            @Html.EditorFor(model => item)
                        }
                    </div>
                </div>

            </div>

        </div>
        <div class="clearfix mb-lg"></div>

        <div class="form-group">
            @Html.LabelFor(model => model.DescripcionUso, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DisplayFor(model => model.DescripcionUso)
            </div>
        </div>
        <div class="clearfix mb-lg"></div>
        <div class="form-group">
            @Html.LabelFor(model => model.AccionCorrectiva, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.AccionCorrectiva, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
        @*<div class="form-group">
            <label class="control-label col-md-2">Firma del solicitante</label>
            <div class="col-md-10">
                <div class="mb-compose-button">

                    <button type="button" class="btn btn-green" data-toggle="modal" data-target="#myModalFirma">
                        <em class="fa fa-plus"></em>
                        Firma
                    </button>
                </div>

            </div>
        </div>*@

        
        <div class="clearfix mb-lg"></div>
        <hr />
        <div class="form-group">
            <div class="col-md-12 col-md-offset-2">
                <input type="submit" value="Generar salida de Almacen" class="btn btn-primary">
            </div>
        </div>


    </div>
}
<div>
    <a href="@Url.Action("Index")" class="btn btn-default text-primary" title="Regresar">
        <i class="fa fa-arrow-left"></i> Regresar
    </a>
</div>

