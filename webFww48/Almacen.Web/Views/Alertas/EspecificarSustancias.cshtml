@using Almacen.Web.Aplicacion
@using Almacen.Web.Tools
@model Almacen.Web.ViewModels.Alerta


<div class="panel panel-default">
    <div class="panel-heading">

        <div class="">
            <div class="pull-left text-center text-info">
                <em class="fa fa-bell"></em>
            </div>
            <div class="ml-xl">
                <span class="h4 text-bold mt0 mb0">@Html.DisplayFor(model => model.Nombre)</span>
            </div>
        </div>

        <div class=""></div>
    </div>
    <div class="panel-body bt">

        <div class="ml-lg">

            <div class="btn-toolbar pull-left">
                <div class="btn-group">
                    @{
                        switch (Model.idAlertaUnidad)
                        {
                            case (int)EnumAlertaUnidad.Porcentaje:
                                <span class="radial-bar radial-bar-sm radial-bar-@CustomExtension.ToMultiple(Model.Valor,5) radial-bar-danger m0"></span>
                                break;
                            case (int)EnumAlertaUnidad.Dias:
                                <span class="m-xl"></span>
                                <div class="progress progress-striped progress-xs">
                                    <div role="progressbar" aria-valuenow="@CustomExtension.ToMultiple(Model.Valor,10)" aria-valuemin="0" aria-valuemax="100"
                                            class="progress-bar progress-bar-info progress-@CustomExtension.ToMultiple(Model.Valor,10)">
                                        <span class="sr-only">@Model.Valor</span>
                                    </div>
                                </div>

                                break;
                            default:
                                break;
                        }
                    }
                </div>
                <div class="btn-group mt-lg">
                    <span class="h4 ml">@Html.DisplayFor(model => model.Valor)</span>
                    <span class="h4 text-alpha-inverse">@Html.DisplayFor(model => model.tAlertaUnidad.AlertaUnidad)</span>
@if(Model.tAlertaUnidad.idAlertaUnidad == (int)EnumAlertaUnidad.Porcentaje)
{
    <span class="h4 ml">de @Html.DisplayFor(model => model.Valor100referencia) Unidades</span>
}
                    <span class="h6 text-alpha-inverse ml">General para todo el almacen</span>

                </div>
            </div>
            
        </div>


    </div>

</div>
<div class="panel panel-transparent">
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.idAlerta)
    <div class="row">

        <div class="col-md-6">
            <div>Especifique una Sustancia</div>
            @Html.DropDownList("idSustanciaMaterial", ViewBag.idSustanciaMaterial as SelectList,
           new { @class = "form-control required chosen-select",
               data_placeholder = "--Seleccione una sustancia--",
               data_val_required = "La Sustancia es requerida",
               data_val = "true"
           })
            @Html.ValidationMessage("idSustanciaMaterial", "", new { @class = "text-danger" })
        </div>
        
        <div class="col-md-2">
            <div>Valor</div>
            <div class="input-group m-b">
                @Html.Editor("Valor", "", new { htmlAttributes = new { @class = "form-control required",
               data_val_required = "El Valor es requerido",
               data_val = "true",
               type = "number"
           } })
                <span class="input-group-addon">@Html.DisplayFor(model => model.tAlertaUnidad.AlertaUnidad)</span>
            </div>
            @Html.ValidationMessage("Valor", "", new { @class = "text-danger" })

        </div>
        @if (Model.tAlertaUnidad.idAlertaUnidad == (int)EnumAlertaUnidad.Porcentaje)
        {
            <div class="col-md-2">
                <div>Valor al 100</div>
                <div class="input-group m-b">
                    @Html.Editor("Valor100referencia", "", new
               {
                   htmlAttributes = new
                   {
                       @class = "form-control required",
                       data_val_required = "El Valor es requerido",
                       data_val = "true",
                       type = "number"
                   }
               })
                    <span class="input-group-addon">@Html.DisplayFor(model => model.tAlertaUnidad.AlertaUnidad)</span>
                </div>
                @Html.ValidationMessage("Valor100referencia", "", new { @class = "text-danger" })

            </div>
        }
        else
        {
            <div class="col-md-2"></div>
        }
        <div class="col-md-2">
            <div>&nbsp;</div>
            <button type="submit" class="btn btn-primary shadow-z1">
                Agregar
            </button>
        </div>

    </div>
}
</div>
<hr />
<div class="clearfix text-bold">Listado de Alertas para Sustancias</div>
<div class="panel">
    @foreach (var item in Model.tAlertaXSustanciaMaterial)
    {


        <div class="panel-body m0 bb">

            <div class="ml-lg">

                <div class="btn-toolbar pull-left">
                    <span class="btn-group">
                        @{
                            switch (Model.idAlertaUnidad)
                            {
                                case (int)EnumAlertaUnidad.Porcentaje:
                                    <span class="radial-bar radial-bar-sm radial-bar-@CustomExtension.ToMultiple(item.Valor,5) radial-bar-danger m0"></span>
                                    break;
                                case (int)EnumAlertaUnidad.Dias:
                                    <span class="m-xl"></span>
                                    <span class="progress progress-striped progress-xs">
                                        <span role="progressbar" aria-valuenow="@CustomExtension.ToMultiple(item.Valor,10)" aria-valuemin="0" aria-valuemax="100"
                                                class="progress-bar progress-bar-info progress-@CustomExtension.ToMultiple(item.Valor,10)">
                                            <span class="sr-only">@item.Valor</span>
                                        </span>
                                    </span>

                                    break;
                                default:
                                    break;
                            }
                        }
                    </span>
                    <span class="btn-group mt">
                        <span class="ml">@Html.DisplayFor(model => item.Valor)</span>
                        <span class="text-alpha-inverse">@Html.DisplayFor(model => model.tAlertaUnidad.AlertaUnidad)</span>
                        @if (Model.tAlertaUnidad.idAlertaUnidad == (int)EnumAlertaUnidad.Porcentaje)
                        {
                            <span class="ml">de @Html.DisplayFor(model => item.Valor100referencia) Unidades</span>
                        }
                        <span class="text-alpha-inverse ml">
                            Aplica para
                            <span class="pull-right ml">@Html.Action("DatosSustancia", "DatosAplicacion", new { idSustanciaMaterial = item.idSustanciaMaterial })</span>
                        </span>
                    </span>
                </div>
                <div class="btn-toolbar pull-right">
                    
                    <div class="btn-group">
                        @*@Html.ActionLink("Editar", "EspecificarEdit", new { id = item.idAlertaXSustanciaMaterial }, new { @class = "btn btn-link" })*@
                        <button type="button"
                                class="btn btn-link btnModalEdit"
                                data-id="@item.idAlertaXSustanciaMaterial"
                                data-valedit="@item.Valor"
                                data-valedit100="@item.Valor100referencia"
                                data-toggle="modal"
                                data-target="#myModalEdit">
                            Editar
                        </button>
                    </div>
                    <div class="btn-group">
                       
                        @*@Html.ActionLink("Eliminar", "EspecificarDelete", new { id = item.idAlertaXSustanciaMaterial, idAlerta=item.idAlerta, idCategoria = item.idCategoria }, new { @class = "btn btn-link" })*@
                        <button type="button" 
                                class="btn btn-link btnModalDelete"
                                data-actionurl="@Url.Action("EspecificarDelete", "Alertas",new { id = item.idAlertaXSustanciaMaterial, idAlerta=item.idAlerta, idCategoria = item.idCategoria })"
                                data-toggle="modal" 
                                data-target="#modalConfirmDelete">
                            Eliminar
                        </button>
                    </div>
                </div>
            </div>


        </div>


        <div class="clearfix"></div>

    }
</div>
<div>
    <a href="@Url.Action("Index")" class="btn btn-default text-primary" title="Regresar">
        <i class="fa fa-arrow-left"></i> Regresar
    </a>
</div>

@section BodyArea {

    <div id="myModalEdit" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" class="modal fade" style="display: none;">
        <div class="modal-dialog modal-notify modal-green">
@using (Html.BeginForm("EspecificarEdit", "Alertas",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    
    @Html.Hidden("idAlertaXSustanciaMaterial")

            <div class="modal-content">

                <div class="modal-header">
                    <button type="button" data-dismiss="modal" aria-label="Close" class="close">
                        <span aria-hidden="true" class="text-white">×</span>
                    </button>
                    <h4 id="myModalLabel" class="modal-title text-white">Editar Alerta</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        @Html.Label("Valor", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="input-group m-b">
                                @Html.Editor("ValorEdit", "", new
                           {
                               htmlAttributes = new
                               {
                                   @class = "form-control required",
                                   data_val_required = "El Valor es requerido",
                                   data_val = "true",
                                   type = "number"
                               }
                           })
                                <span class="input-group-addon">@Html.DisplayFor(model => model.tAlertaUnidad.AlertaUnidad)</span>
                            </div>

                            @Html.ValidationMessage("ValorEdit", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Valor  al 100", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="input-group m-b">
                                @Html.Editor("Valor100referenciaEdit", "", new
                               {
                                   htmlAttributes = new
                                   {
                                       @class = "form-control required",
                                       data_val_required = "El Valor es requerido",
                                       data_val = "true",
                                       type = "number"
                                   }
                               })
                                <span class="input-group-addon">@Html.DisplayFor(model => model.tAlertaUnidad.AlertaUnidad)</span>
                            </div>

                            @Html.ValidationMessage("Valor100referenciaEdit", "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="modal-footer">

                    <input id="btnModalGuardar" type="submit" value="Guardar" class="btn btn-primary">

                    <button type="button" data-dismiss="modal" class="btn btn-default">Cancelar</button>
                </div>
            </div>
}
        </div>
    </div>

    <!--Modal: modalConfirmDelete-->
<div class="modal fade" id="modalConfirmDelete" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-notify modal-danger modal-sm">
        <!--Content-->
        <div class="modal-content text-center">
            <!--Header-->
            <div class="modal-header text-center">
                <p class="heading">Esta seguro de eliminar esta configuracion?</p>
            </div>

            <!--Body-->
            <div class="modal-body">

                <i class="fa fa-times fa-4x animated rotateIn"></i>

            </div>

            <!--Footer-->
            <div class="modal-footer text-center">
                <a id="btnModalAceptar" href="#" class="btn  btn-outline-danger">Aceptar</a>
                <a href="#" type="button" class="btn  btn-danger waves-effect" data-dismiss="modal">Cancelar</a>
            </div>
        </div>
        <!--/.Content-->
    </div>
</div>
<!--Modal: modalConfirmDelete-->
}



    @section Styles {

        <link href="@Styles.Url("~/Content/modal.min.css")" rel="stylesheet" type="text/css" />
    }
    @section Scripts {

        @Scripts.Render("~/bundles/chosen")

        <script type="text/javascript">

            $(".chosen-select").chosen({ no_results_text: "Resultados no encontrados para:" });

            $(".btnModalDelete").click(function () {
            
                var href=$(this).attr('data-actionurl');
                $("#btnModalAceptar").attr('href', href);

            })

            $(".btnModalEdit").click(function () {

                var id = $(this).attr('data-id');
                var valedit = $(this).attr('data-valedit');
                var valedit100 = $(this).attr('data-valedit100');
                $('input[id="idAlertaXSustanciaMaterial"]').val(id);
                $('input[id="ValorEdit"]').val(valedit);
                $('input[id="Valor100referenciaEdit"]').val(valedit100);

            })
            


        </script>
    }
