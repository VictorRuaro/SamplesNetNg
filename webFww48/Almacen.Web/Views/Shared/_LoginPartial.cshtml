@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {
    @Html.AntiForgeryToken()

    <ul class="nav navbar-nav navbar-right navbar-collapse">
        <li class="navbar-link">
            @*@Html.ActionLink("Hola " + User.Identity.GetUserName() + "!", "Index", "Manage", routeValues: null, htmlAttributes: new { title = "Manage" })*@

            <a href="@Url.Action("Index", "Manage")" title = "Administrar">
                <em class="icon-user"></em> <span class="hidden-xs">@User.Identity.Name</span> 
            </a>
        </li>
        <li class="navbar-link">
            <a href="javascript:document.getElementById('logoutForm').submit()" title = "Cerrar sesión">
                <em class="icon-lock-open"></em> <span class="hidden-xs">Cerrar sesión</span> 
                
            </a>
        </li>
    </ul>
    }
}
else
{
    <ul class="nav navbar-nav navbar-right navbar-collapse">
        @*<li>@Html.ActionLink("Registrarse", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink" })</li>*@
        <li class="navbar-link">
            @*@Html.ActionLink("Iniciar sesión", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })*@

            <a href="@Url.Action( "Login", "Account")" id = "loginLink" data-toggle-state="offsidebar-open" data-no-persist="true">
                <em class="icon-lock"></em> Iniciar sesión
            </a>
        </li>
    </ul>
}
