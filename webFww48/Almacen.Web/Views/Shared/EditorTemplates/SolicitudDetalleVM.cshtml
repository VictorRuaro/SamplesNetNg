@using Almacen.Web.Aplicacion
@model Almacen.Web.ViewModels.SolicitudDetalleVM

<tr>

    <td class="">
        @Html.HiddenFor(modelItem => modelItem.index, new
   {
       @Name = string.Format("Materiales[{0}].index", Model.index),
       @id = string.Format("Materiales[{0}].index", Model.index)
   })
        @Html.HiddenFor(modelItem => modelItem.idCategoria, new
   {
       @Name = string.Format("Materiales[{0}].idCategoria", Model.index),
       @id = string.Format("Materiales[{0}].idCategoria", Model.index)
   })
        @Html.HiddenFor(modelItem => modelItem.idSolicitudDetalle, new
   {
       @Name = string.Format("Materiales[{0}].idSolicitudDetalle", Model.index),
       @id = string.Format("Materiales[{0}].idSolicitudDetalle", Model.index)
   })
        @Html.HiddenFor(modelItem => modelItem.idSustanciaMaterial, new
   {
       @Name = string.Format("Materiales[{0}].idSustanciaMaterial", Model.index),
       @id = string.Format("Materiales[{0}].idSustanciaMaterial", Model.index)
   })
        @Html.HiddenFor(modelItem => modelItem.Descripcion, new
   {
       @Name = string.Format("Materiales[{0}].Descripcion", Model.index),
       @id = string.Format("Materiales[{0}].Descripcion", Model.index)
   })
        @Html.HiddenFor(modelItem => modelItem.idEstatusSolicitud, new
   {
       @Name = string.Format("Materiales[{0}].idEstatusSolicitud", Model.index),
       @id = string.Format("Materiales[{0}].idEstatusSolicitud", Model.index)
   })


        @*@Html.DisplayFor(modelItem => modelItem.Descripcion)*@
        <div class="">
            @if(Model.idCategoria == (int)EnumCategoria.Sustancias)
            {
                @Html.Action("DatosSustancia", "DatosAplicacion", new { idSustanciaMaterial = Model.idSustanciaMaterial })
            }
            else
            {
                @Html.Action("DatosMaterial", "DatosAplicacion", new { idSustanciaMaterial = Model.idSustanciaMaterial })
            }
        </div>
    </td>

    @{
        switch (Model.idEstatusSolicitud)
        {
            case 0:

                <td class="">
                    @Html.EditorFor(modelItem => modelItem.CantidadSolicitada, "", new
               {
                   htmlAttributes = new
                   {
                       @Name = string.Format("Materiales[{0}].CantidadSolicitada", Model.index),
                       @id = string.Format("Materiales[{0}].CantidadSolicitada", Model.index),
                       @class = "form-control",
                   }
               })

                    @Html.ValidationMessageFor(modelItem => modelItem.CantidadSolicitada, "", new
               {
                   @class = "text-danger",
                   @data_valmsg_for = string.Format("Materiales[{0}].CantidadSolicitada", Model.index)
               })
                </td>
                <td class="">
                    <input class="btn btn-link btnEliminarSustancia" type="button" value="Eliminar"
                           data-actionurl="@Url.Action("ListaEliminarElemento", "SolicitudSustancias")"
                           data-id="@Model.index">
                </td>
                break;
            case 1:

                <td class="">
                    @Html.EditorFor(modelItem => modelItem.CantidadSolicitada, "", new
               {
                   htmlAttributes = new
                   {
                       @Name = string.Format("Materiales[{0}].CantidadSolicitada", Model.index),
                       @id = string.Format("Materiales[{0}].CantidadSolicitada", Model.index),
                       @class = "form-control",
                   }
               })
                    
                    @Html.ValidationMessageFor(modelItem => modelItem.CantidadSolicitada, "", new
               {
                   @class = "text-danger",
                   @data_valmsg_for = string.Format("Materiales[{0}].CantidadSolicitada", Model.index)
               })
                </td>
                <td class="">
                    <input class="btn btn-link btnEliminarSustancia" type="button" value="Eliminar"
                           data-actionurl="@Url.Action("ListaEliminarElemento", "SolicitudSustancias")"
                           data-id="@Model.index">
                </td>
                break;
            case 2:

                <td class="">
                    @Html.HiddenFor(modelItem => modelItem.CantidadSolicitada, new
               {
                   @Name = string.Format("Materiales[{0}].CantidadSolicitada", Model.index),
                   @id = string.Format("Materiales[{0}].CantidadSolicitada", Model.index)
               })
                    @Html.DisplayFor(modelItem => modelItem.CantidadSolicitada)
                </td>
                if(User.IsInRole(EnumRol.Administrador) || User.IsInRole(EnumRol.Autorizador_Material) || User.IsInRole(EnumRol.Autorizador_Sustancias))
                {
                <td class="">
                    @Html.EditorFor(modelItem => modelItem.CantidadAutorizada, "", new
                   {
                       htmlAttributes = new
                       {
                           @Name = string.Format("Materiales[{0}].CantidadAutorizada", Model.index),
                           @id = string.Format("Materiales[{0}].CantidadAutorizada", Model.index),
                           @class = "form-control",
                       }
                   })
                    @Html.ValidationMessageFor(modelItem => modelItem.CantidadAutorizada, "", new
                   {
                       @class = "text-danger",
                       @data_valmsg_for = string.Format("Materiales[{0}].CantidadAutorizada", Model.index)
                   })
                </td>
                }
                @*<td class="">
        <input class="btn btn-link btnEliminarSustancia" type="button" value="Eliminar"
               data-actionurl="@Url.Action("ListaEliminarElemento", "SolicitudSustancias")"
               data-id="@Model.index">
    </td>*@
                break;
            case 3:

                <td class="">
                    @Html.HiddenFor(modelItem => modelItem.CantidadSolicitada, new
               {
                   @Name = string.Format("Materiales[{0}].CantidadSolicitada", Model.index),
                   @id = string.Format("Materiales[{0}].CantidadSolicitada", Model.index)
               })
                    @Html.DisplayFor(modelItem => modelItem.CantidadSolicitada)
                </td>

                <td class="">
                    @Html.HiddenFor(modelItem => modelItem.CantidadAutorizada, new
               {
                   @Name = string.Format("Materiales[{0}].CantidadAutorizada", Model.index),
                   @id = string.Format("Materiales[{0}].CantidadAutorizada", Model.index)
               })
                    @Html.DisplayFor(modelItem => modelItem.CantidadAutorizada)
                </td>

                <td class="">
                    @Html.EditorFor(modelItem => modelItem.CantidadSurtida, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(modelItem => modelItem.CantidadSurtida, "", new { @class = "text-danger" })
                </td>

                <td class="">
                    @Html.EditorFor(modelItem => modelItem.CantidadDevolver, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(modelItem => modelItem.CantidadDevolver, "", new { @class = "text-danger" })
                </td>
                <td class="">
                    <button type="button" class="btn btn-green" data-toggle="modal" data-target="#myModalLote">
                        <em class="fa fa-plus"></em>
                        Seleccionar Lote
                    </button>
                </td>
                break;
            case 4:

                <td class="">
                    @Html.DisplayFor(modelItem => modelItem.CantidadSolicitada)
                </td>

                <td class="">
                    @Html.DisplayFor(modelItem => modelItem.CantidadAutorizada)
                </td>

                <td class="">
                    @Html.DisplayFor(modelItem => modelItem.CantidadSurtida, new { htmlAttributes = new { @class = "form-control" } })
                </td>

                <td class="">
                    @Html.DisplayFor(modelItem => modelItem.CantidadDevolver, new { htmlAttributes = new { @class = "form-control" } })
                </td>
                <td class="">
                    @Html.EditorFor(modelItem => modelItem.CantidadDevuelta, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(modelItem => modelItem.CantidadDevuelta, "", new { @class = "text-danger" })
                </td>
                break;
            default:
                break;
        }
    }

</tr>