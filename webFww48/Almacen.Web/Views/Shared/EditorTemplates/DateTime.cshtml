    <div class="input-group-addon">
        <span class="bg-white cursor-pointer shadow-z2">
            <em class="fa fa-fw fa-calendar text-pink"></em>
        </span>
    </div>
    @Html.TextBox("", (Model.HasValue ? Model.Value.ToShortDateString() : string.Empty), new { @class = "form-control" })
</div>

