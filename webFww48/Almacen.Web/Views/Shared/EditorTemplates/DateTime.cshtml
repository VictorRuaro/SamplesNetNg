<script type="text/javascript">
    $(function () {

        var locale = window.navigator.userLanguage || window.navigator.language;
        var mo = moment.localeData(locale);

                $('.datetimepicker').datetimepicker({
                    locale: locale,
                    format:'L'
                });
            });
</script>

<style>
    .cursor-pointer{cursor: pointer;}
</style>