    <style>
        .progreso-main {
            background-color: white;
            opacity: .5;
        }

        .progreso {
            position: fixed;
            top: 50%;
            left: 50%;
            height: 6em;
            padding-top: 2.3em;
            z-index: 1;
            /* The following properties are the ones most likely to change */
            width: 20em;
            /* Set 'margin-left' to a negative number that is 1/2 of 'width' */
            margin-left: -10em;
            padding-left: 2.1em;
        }

        /* Changing style for spinner */
        .progreso {
            padding-top: 2em;
            width: 23em;
            margin-left: -11.5em; /* Set to a negative number that is 1/2 of the width */
        }

            .progreso i {
                margin-right: 0.5em;
            }
    </style>
    <script>

        var panelSelector = '[data-tool="link-load"]';
        var saveSelector = '[data-tool="save-load"]';

        // catch clicks to toggle panel refresh
        $(document).on('click', panelSelector, function () {
            // Trigger the event and send the panel object
            onLoad();

        });



        function DisplayProgress(ctl, msg) {
            // Turn off the "Save" button and change text
            $(ctl).prop("disabled", true).text(msg);
            
            

            // Gray out background on page
            
            $('#loading').toggleClass('sk-loading');
            // Wrap in setTimeout so the UI can update the spinners
            //setTimeout(function () {
            //$(".progreso").removeClass("hidden");
            //}, 1);

            return true;
        }
        
        //onLoad();
        var time = 10;
        var chkReadyState = setInterval(function () {
            if (document.readyState == "complete") {
                // clear the interval
                complete();
                clearInterval(chkReadyState);
                // finally your page is loaded.
            }
        }, time);

        function onLoad() {
            var ctl = $("loading");
            DisplayProgress(ctl, "hola");

            console.log('The page is loading');
        };
        function complete() {

            setTimeout(function () {
                $('#loading').toggleClass('sk-loading');
                
                //$(".progreso").addClass("hidden");
            }, 10);

            console.log('The page is loaded');
        };

    </script>
    <script type="text/javascript">
