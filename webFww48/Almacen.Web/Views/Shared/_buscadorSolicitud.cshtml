@using Almacen.Web.ViewModels
@using Almacen.Web.ViewModels.Catalogos

@model SolicitudFiltrosVM

<div class="">
    <div class="">
        @*<input class="form-control mb" type="text" placeholder="Ingrese el texto a buscar">*@
        <div class="row">
            <div class="col-lg-6">
                @Html.HiddenFor(model => model.idCategoria)
                <div class="form-group">
                    @Html.LabelFor(model => model.Folio, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Folio, new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.Folio, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Descripcion, new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.DescripcionUso, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.DescripcionUso, new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.DescripcionUso, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                
@if (ViewBag.idEstatusSolicitud != null)
{
                <div class="form-group">
                    @Html.LabelFor(model => model.idEstatusSolicitud, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.idEstatusSolicitud, null, new { @class = "form-control input-sm" })
                        @Html.ValidationMessageFor(model => model.idEstatusSolicitud, "", new { @class = "text-danger" })
                    </div>
                </div>
}
@if (ViewBag.idSolicitante != null)
{
                <div class="form-group">
                    @Html.LabelFor(model => model.idSolicitante, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.idSolicitante, null, new { @class = "form-control input-sm" })
                        @Html.ValidationMessageFor(model => model.idSolicitante, "", new { @class = "text-danger" })
                    </div>
                </div>
}
@if (ViewBag.idAutorizador != null)
{
                <div class="form-group">
                    @Html.LabelFor(model => model.idAutorizador, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.DropDownListFor(model => model.idAutorizador, null, new { @class = "form-control input-sm" })
                        @Html.ValidationMessageFor(model => model.idAutorizador, "", new { @class = "text-danger" })
                    </div>
                </div>
}
                @if (ViewBag.ModuloAutorizar != null)
                {
                    <div class="form-group">
                        @Html.LabelFor(model => model.EstatusAutorizadas, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.EstatusAutorizadas)
            
                        </div>
                    </div>
                }

                @if (ViewBag.ModuloSurtir != null)
                {
                    <div class="form-group">
                        @Html.LabelFor(model => model.EstatusSurtidas, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.EstatusSurtidas)

                        </div>
                    </div>
                }

                @if (ViewBag.ModuloSurtidasDevolucion != null)
                {
                    <div class="form-group">
                        @Html.LabelFor(model => model.EstatusSurtidasDevolucion, htmlAttributes: new { @class = "control-label col-md-4" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.EstatusSurtidasDevolucion)

                        </div>
                    </div>
                }
                

            </div>
            <div class="clearfix"></div>
            <div class="form-group mt-lg">
                <div class="col-md-offset-4 col-lg-offset-2 col-md-8 col-lg-10">
                    <button class="pull-left btn btn-default shadow-z1" type="submit">
                        Buscar
                        <i class="fa fa-search ml"></i>
                    </button>

                </div>
            </div>

        </div>
    </div>
</div>