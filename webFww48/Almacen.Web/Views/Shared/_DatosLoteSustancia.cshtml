            <dt>
                @Html.DisplayNameFor(model => model.Concentracion)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Concentracion) @Html.DisplayFor(model => model.cUMConcentracion.UMConcentracion)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.Existencia)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.Existencia)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.FechaRecepcion)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.FechaRecepcion)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.FechaCaducidad)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.FechaCaducidad)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.cTipoSal.TipoSal)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.cTipoSal.TipoSal)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.cProveedor.Proveedor)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.cProveedor.Proveedor)
            </dd>
            <dt>
                @Html.DisplayNameFor(model => model.LoteProveedor)
            </dt>
            <dd>
                @Html.DisplayFor(model => model.LoteProveedor)
            </dd>
            <dt>
