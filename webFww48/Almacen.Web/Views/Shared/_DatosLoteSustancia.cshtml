            </dt>
            <dd>
                @Html.DisplayFor(model => model.cDisolvente.Disolvente)
            </dd>
        </dl>
    </div>
    
</div>
<style type="text/css">
/* Popover styling */

a {
  text-decoration: none;
}

.popover__title {

}

.popover__wrapper {
    display: inline-block;
}

.popover__content_rigth {
    opacity: 0;
    right: calc(5% - 10px);
    visibility: hidden;
    position: absolute;
    transform: translate(0,10px);
    width: auto;
    background-color:white;
}

.popover__content_rigth:before {
    position: absolute;
    z-index: -1;
    content: '';
    right: calc(5% - 10px);
    top: -8px;
    border-style: solid;
    border-width: 0 10px 10px 10px;
    border-color: transparent transparent #BFBFBF transparent;
    transition-duration: 0.3s;
    transition-property: transform;

}
.popover__wrapper:hover .popover__content_rigth {
    z-index: 10;
    opacity: 1;
    visibility: visible;
    transform: translate(0,2px);
    transition: all 0.5s cubic-bezier(0.75, -0.02, 0.2, 0.97);
}
.popover__message {
  text-align: center;
}
</style>