@model Almacen.Web.ViewModels.PaginadorViewModels

@{
    var cantidadPaginas = (int)Math.Ceiling((double)Model.TotalRegistros / Model.RegistrosPorPagina);
    ViewData.TemplateInfo.HtmlFieldPrefix = "Paginador";
}

<!--Funcionalidad: Anterior y siguiente-->
@Html.HiddenFor(model => model.PaginaActual)
@Html.HiddenFor(model => model.RegistrosPorPagina)
<ul class="pagination">
    @if (Model.PaginaActual == 1)
    {
        Model.PaginaActual = 1;
        <li class="disabled">
            @*@Html.ActionLink("Anterior", null, Model.ValoresQueryString)*@
            <input type="submit" value="Anterior" class="btn btn-default" />
        </li>
    }
    else
    {
        Model.PaginaActual -= 1;
        <li>
            @*@Html.ActionLink("Anterior", null, Model.ValoresQueryString)*@
            <input type="submit" value="Anterior" class="btn btn-default" />
        </li>
    }

    @if (Model.PaginaActual == cantidadPaginas)
    {
        Model.PaginaActual = cantidadPaginas;
        <li class="disabled">
            @*@Html.ActionLink("Siguiente", null, Model.ValoresQueryString)*@
            <input type="submit" value="Siguiente" class="btn btn-default" />
        </li>
    }
    else
    {
        Model.PaginaActual += 1;
        <li>
            @*@Html.ActionLink("Siguiente", null, Model.ValoresQueryString)*@
            <input type="submit" value="Siguiente" class="btn btn-default" />
        </li>
    }
</ul>

<!--Funcionalidad: Páginas-->

@{
    int Inicial = 1;
    var radio = 3;
    var cantidadMaximaDePaginas = radio * 2 + 1;
    int Final = (cantidadPaginas > cantidadMaximaDePaginas) ? cantidadMaximaDePaginas : cantidadPaginas;
    if (Model.PaginaActual > radio + 1)
    {
        Inicial = Model.PaginaActual - radio;
        if (cantidadPaginas > Model.PaginaActual + radio)
        {
            Final = Model.PaginaActual + radio;
        }
        else
        {
            Final = cantidadPaginas;
        }
    }
}


<ul class="pagination">
    @{Model.PaginaActual = 1; }
    <li>@Html.ActionLink("Primera", null, Model.ValoresQueryString)</li>
    @for (int i = Inicial; i <= Final; i++)
    {
        Model.PaginaActual = i;
        if (i == Model.PaginaActual)
        {
            <li class="active">@Html.ActionLink(i.ToString(), null, Model.ValoresQueryString)</li>
        }
        else
        {
            <li>@Html.ActionLink(i.ToString(), null, Model.ValoresQueryString)</li>
        }
    }
    @{Model.PaginaActual = cantidadPaginas; }
    <li>@Html.ActionLink("Ultima", null, Model.ValoresQueryString)</li>
</ul>
