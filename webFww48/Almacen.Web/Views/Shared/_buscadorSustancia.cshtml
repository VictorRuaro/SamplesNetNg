@using Almacen.Web.ViewModels
@using Almacen.Web.ViewModels.Catalogos

@model SustanciaFiltrosVM
<div class="">
    <div class="mb-lg">
        <div class="row">
            <div class="col-lg-8">
                @Html.HiddenFor(model => model.idCategoria)
                <div class="form-group">
                    @Html.LabelFor(model => model.Codigo, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Codigo, new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Descripcion,"", "DescripcionBuscar", new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.idGrupoFarmacologico, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">

                        @Html.DropDownListFor(model => model.idGrupoFarmacologico, null, new { @class = "form-control input-sm" })

                        @Html.ValidationMessageFor(model => model.idGrupoFarmacologico, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="clearfix"></div>
                <div class="form-group">
                    @Html.LabelFor(model => model.EsSustanciaControlada, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">

                        @*<div class="checkbox c-checkbox">
                            <label>
                                <input name="EsSustanciaControlada" id="EsSustanciaControlada" type="checkbox" @(Model.EsSustanciaControlada != null ? "checked='checked'" : "") value="true">
                                <span class="fa fa-check bg-white"></span>
                                <input name="EsSustanciaControlada" type="hidden" value="@Model.EsSustanciaControlada">
                            </label>
                        </div>*@
                        @Html.EditorFor(model => model.EsSustanciaControlada)
                        @Html.ValidationMessageFor(model => model.EsSustanciaControlada, "", new { @class = "text-danger" })
                    </div>


                </div>
                <div class="clearfix"></div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Sinonimos, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Sinonimos, new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.Sinonimos, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.CAS, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.CAS, new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.CAS, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.PMCompuesto, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.PMCompuesto, new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.PMCompuesto, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.FormulaMolecular, htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.FormulaMolecular, new { htmlAttributes = new { @class = "form-control input-sm" } })
                        @Html.ValidationMessageFor(model => model.FormulaMolecular, "", new { @class = "text-danger" })
                    </div>
                </div>



                <div class="clearfix"></div>
                <div class="form-group mt-lg">
                    <div class="col-md-offset-4 col-md-8">
                        <button id="btnModalBuscarSustancia" class="pull-left btn btn-default shadow-z1" type="submit"
                                data-actionurl="@Url.Action("ListadoSustanciasSelect", "SolicitudSustancias",null)">
                            Buscar
                            <i class="fa fa-search ml"></i>
                        </button>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

