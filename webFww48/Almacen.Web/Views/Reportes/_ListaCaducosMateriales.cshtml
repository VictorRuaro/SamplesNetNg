@using Almacen.Data

@model IEnumerable<sp_Rpt_Caducos_Materiales_Result>

<div class="panel panel-default">
    <div class="table-responsive h6">

        <table class="table table-hover table-condensed " id="table">
            <thead>
                <tr class="tableizer-firstrow">
                    <th>ID</th>
                    <th>Nombre </th>
                    <th>Grado</th>
                    <th>Numero de Parte</th>
                    <th>No. de Lote</th>
                    <th>Nº de Catalogo</th>
                    <th>Marca</th>
                    <th>Presentación</th>
                    <th>Unidades Recibidas</th>
                    <th>Proveedor</th>
                    <th>Lote de Proveedor</th>
                    <th>Fecha de Recepción </th>
                    <th>Fecha de Caducidad </th>
                    <th>Condiciones de Almacenaje</th>
                    <th>Observaciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null)
                {
                    <tr>
                        <td colspan="19">
                            <div class="alert alert-warning"><i class="fa fa-warning mr"></i><strong>No se han ingresado datos</strong></div>
                        </td>
                    </tr>

                }
                else if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Codigo)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Material)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Grado)
                            </td>
                            
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Numero_de_Parte)
                            </td>

                            <td class="">
                                @Html.DisplayFor(modelItem => item.Lote_Interno)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.No__Catalogo)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Marca)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Presentacion)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Unidades_Recibidas)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Proveedor)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Lote_Proveedor)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Fecha_Recepcion)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Fecha_Caducidad)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Condiciones_Almacenaje)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Observaciones)
                            </td>

                        </tr>
                    }

                }
                else
                {
                    <tr>
                        <td colspan="19">
                            <div class="alert alert-info"><i class="fa fa-warning mr"></i><strong>No se encontraron datos con los filtros ingresados</strong></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>

</div>

