@using Almacen.Web.ViewModels
@using Almacen.Web.ViewModels.Reportes

@model Rpt_Material_FiltrosVM
<div id="panelDemo1" class="panel panel-transparent">
    <div class="panel-heading">
        <div class="well well-sm mb0">
            <span class="text-alpha-inverse text-bold">Filtros</span>
            <a href="#" class="btn btn-circle btn-info shadow-z1" data-tool="panel-collapse" data-toggle="tooltip" title="Mostrar/Ocultar Filtros">
                <em class="fa fa-minus"></em>
            </a>
        </div>
    </div>
    <div class="panel-wrapper collapse in">
        <div class="panel-body">
            <div class="">
                <div class="mb-lg">
                    <div class="row">
                        <div class="col-lg-8">
                            @*@Html.HiddenFor(model => model.idCategoria)*@
                            <div class="form-group">
                                @Html.LabelFor(model => model.Codigo, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.Codigo, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.Descripcion, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.idGrado, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">

                                    @Html.DropDownListFor(model => model.idGrado, null, new { @class = "form-control input-sm" })

                                    @Html.ValidationMessageFor(model => model.idGrado, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="clearfix"></div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.NumeroParte, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.NumeroParte, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.NumeroParte, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="form-group">
                                @Html.LabelFor(model => model.LoteInterno, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.LoteInterno, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.LoteInterno, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.NumCatalago, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.NumCatalago, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.NumCatalago, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.idMarca, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">

                                    @Html.DropDownListFor(model => model.idMarca, null, new { @class = "form-control input-sm" })

                                    @Html.ValidationMessageFor(model => model.idMarca, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.idPresentacion, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.idPresentacion, null, new { @class = "form-control input-sm chosen-select", data_placeholder = "--Seleccione una opcion--" })
                                    @Html.ValidationMessageFor(model => model.idPresentacion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.idProveedor, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">

                                    @Html.DropDownListFor(model => model.idProveedor, null, new { @class = "form-control input-sm" })

                                    @Html.ValidationMessageFor(model => model.idProveedor, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.LoteProveedor, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.LoteProveedor, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.LoteProveedor, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.FechaRecepcion, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.FechaRecepcion, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.FechaRecepcion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            @if(ViewBag.RptCaducos==null)
                {
                            <div class="form-group">
                                @Html.LabelFor(model => model.FechaCaducidad, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.FechaCaducidad, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.FechaCaducidad, "", new { @class = "text-danger" })
                                </div>
                            </div>
                }
                            <div class="form-group">
                                @Html.LabelFor(model => model.idCondicionesAlmacenaje, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.DropDownListFor(model => model.idCondicionesAlmacenaje, null, new { @class = "form-control input-sm chosen-select", data_placeholder = "--Seleccione una opcion--" })
                                    @Html.ValidationMessageFor(model => model.idCondicionesAlmacenaje, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Observaciones, htmlAttributes: new { @class = "control-label col-md-4" })
                                <div class="col-md-8">
                                    @Html.EditorFor(model => model.Observaciones, new { htmlAttributes = new { @class = "form-control input-sm" } })
                                    @Html.ValidationMessageFor(model => model.Observaciones, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @if (ViewBag.MenuSinExistencia != null)
                            {
                                <div class="form-group">
                                    @Html.LabelFor(model => model.IncluirPorcentajeMinimo, htmlAttributes: new { @class = "control-label col-md-4" })
                                    <div class="col-md-8">
                                        @Html.EditorFor(model => model.IncluirPorcentajeMinimo)

                                    </div>
                                </div>
                            }

                            <div class="clearfix"></div>
                            <div class="form-group mt-lg">
                                <div class="col-md-offset-4 col-md-8">
                                    <button id="btnFiltros" class="pull-left btn btn-default shadow-z1" type="submit">
                                        Buscar
                                        <i class="fa fa-search ml"></i>
                                    </button>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<!-- END panel-->
