@using Almacen.Web.ViewModels
@using Almacen.Web.Aplicacion

@model SolicitudVM
<h3>Surtir Materiales</h3>
<link href="~/Content/modal.min.css" rel="stylesheet" />

    <div class="form-horizontal">
        
        <div class="panel panel-default">
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.idSolicitud)
    @Html.HiddenFor(model => model.Folio)
    @Html.HiddenFor(model => model.UG)
    @Html.HiddenFor(model => model.FG)
    @Html.HiddenFor(model => model.idCategoria)
    @Html.HiddenFor(model => model.idSolicitante)
    @Html.HiddenFor(model => model.idAutorizador)
    @Html.HiddenFor(model => model.idEstatusSolicitud)
    @Html.HiddenFor(model => model.cEstatusSolicitud.idEstatusSolicitud)
    @Html.HiddenFor(model => model.cEstatusSolicitud.NumEstatus)
    @Html.HiddenFor(model => model.cEstatusSolicitud.EstatusSolicitud)

            <div class="panel-heading">
                <div class="media-box bb">
                    <div class="pull-left">
                        <span class="fa-stack">
                            <em class="fa fa-circle fa-stack-2x text-gray"></em>
                            <em class="fa fa-file-text fa-stack-1x fa-inverse"></em>
                        </span>
                    </div>
                    <div class="media-box-body clearfix">

                        <label class="pull-right ml text-purple">Estatus: <span class="label label-warning text-sm">@Model.cEstatusSolicitud.EstatusSolicitud</span></label>

                        <div class="media-box-heading">
                            <label class="text-muted">
                                Solicitud

                            </label>
                        </div>
                        <div class="m0">
                            
                            <span class="text-bold text-purple">Folio: @Model.Folio</span>
                            <span class="pull-right text-muted">Fecha de Elaboración: @Model.FG.ToShortDateString()</span>
                        </div>
                        <div class="clearfix">
                            <span class="pull-right text-bold">Fecha de Envio: @Model.FechaEnvio</span>
                            <span class="text-bold">Solicitante: @Html.Action("DatosUsuario", "DatosAplicacion", new { IdUsuario = Model.UG })</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-body">
                <div class="form-group">
                    @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <div class="bb p-sm">
                            @Html.HiddenFor(model => model.Descripcion)
                            @Html.DisplayFor(model => model.Descripcion)
                        </div>
                    </div>
                </div>

                <div class="row form-group">
                    <div class="">
                        @Html.LabelFor(model => model.Materiales, "Materiales", htmlAttributes: new { @class = "control-label col-md-2" })

                        <div class="col-md-10">
                            <div class="clearfix mb">
                                @*<div class="btn-group">
                                    <button type="button" class="btn btn-labeled btn-oval btn-info" data-toggle="modal" data-target="#modalPoll">
                                        <span class="btn-label btn-circle">
                                            <i class="fa fa-plus"></i>
                                        </span>
                                        Agregar material
                                    </button>

                                </div>*@
                            </div>
                            <div id="ListaSolicitud" class="">
                                @if (Model.Materiales != null)
                                {
                                    <div class="panel panel-default">
                                        <div class="table-responsive">

                                            <table id="tablaListado" class="table table-hover table-condensed ">
                                                <thead class="">
                                                    <tr>
                                                        <th>
                                                            @Html.DisplayNameFor(model => Model.Model.Descripcion)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => Model.Model.idPresentacion)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => Model.Model.CantidadSolicitada)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => Model.Model.CantidadAutorizada)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => Model.Model.CantidadSurtida)
                                                        </th>
                                                        <th>
                                                            @Html.DisplayNameFor(model => Model.Model.CantidadDevolver)
                                                        </th>
                                                        <th>

                                                        </th>

                                                    </tr>
                                                </thead>

                                                <tbody class="h6">
                                                    @{


                                                        for (int i = 0; i < Model.Materiales.Count(); i++)
                                                        {
                                                            Model.Materiales[i].index = i;
                                                            @Html.EditorFor(modelItem => Model.Materiales[i])

                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                                            
                                                        }
                                                        else
                                                        {
                                    <div class="well bg-gray-lighter"><i class="fa fa-warning mr text-warning"></i><span class="text-purple">No se han agregado materiales</span></div>
                                }
                            </div>
                        </div>
                    </div>
                </div>


                <div class="form-group">
                    @Html.LabelFor(model => model.DescripcionUso, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <div class="bb p-sm">
                            @Html.HiddenFor(model => model.DescripcionUso)
                            @Html.Raw(Model.DescripcionUso ?? "&nbsp;")
                        </div>
                    </div>
                </div>
                <div class="clearfix mb-lg"></div>
                <div class="form-group">
                    @Html.LabelFor(model => model.FirmaSolicitante, htmlAttributes: new { @class = "control-label col-md-2" })

                    <div class="col-md-10">
                        <div class="input-group m-b">
                            <div class="input-group-btn">
                                <button id="btnFirmarSolicitud" type="button" class="btn btn-green" data-toggle="modal" data-target="#myModalFirma">
                                    <em class="fa fa-plus"></em>
                                    Firma
                                </button>
                            </div>
                            <div class="list-group-item">
                                <em class="fa fa-user"></em>
                                <span id="msgFirmaSolicitante"></span>
                            </div>
                        </div>

                        <div class="input-valid-hide">
                            @Html.EditorFor(model => model.FirmaSolicitante)
                        </div>
                        <div id="msgErrorFirma">
                            @Html.ValidationMessageFor(model => model.FirmaSolicitante, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel-footer">
@if (Model.ValidaFlujo.visibleBtnGenerarSalida)
{
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input name="btnAccion" class="btn btn-primary" type="submit" value="Generar salida de Almacen">
                        
                    </div>
                </div>
}
            </div>
}
            
        </div>
    </div>

<div>
    <a href="@Url.Action("Index")" class="btn btn-default text-primary" title="Regresar">
        <i class="fa fa-arrow-left"></i> Regresar
    </a>
</div>

@section BodyArea {


    <!-- Modal: modalPoll -->
