@section Styles {
    @*@Styles.Render("~/bundles/datatablesCss")*@
}
@section Scripts {
    @*@Scripts.Render("~/bundles/datatables")*@
@Scripts.Render("~/Scripts/app/requiredIfValidator.js")
@Scripts.Render("~/Scripts/app/valuecomparisonValidator.js")

    <script type="text/javascript">



        $().ready(function () {

            // code here

            //Selecciona Lote
            $(".btnSeleccionaLote").click(
                    function () {

                        var msg=$("#msgModal");
                        msgModalInit(msg);

                        var url = $(this).attr('data-actionurl');
                        var id = $(this).attr('data-id');

                        var urlMaterial='@Url.Action("Material", "DatosAplicacion")';

                        $('div[id="resultadoExistencias"]').toggleClass('sk-loading');

                        $.get(urlMaterial, { idSustanciaMaterial: id })
                                .success(
                                    function (result) {

                                        if (result !== null) {

                                            $('div[id="datosItem"]').html(result);

                                        }
                                        else {

                                            $("#lblInformacionModal").html("");
                                        }

                                    }
                                )
                            .error(function (jqXHR, textStatus, errorThrown) {
                                $('div[id="resultadoExistencias"]').toggleClass('sk-loading');
                                //debugger;
                            }).complete( function () {

                                if (url.length > 0) {

                                    $.get(url, { idSustanciaMaterial: id })
                                        .success(
                                            function (result) {

                                                if (result !== null) {

                                                    $('div[id="resultadoExistencias"]').html(result);

                                                }
                                                else {

                                                    $("#lblInformacionModal").html("");
                                                }
                                            }
                                        )
                                    .error(function (jqXHR, textStatus, errorThrown) {
                                        $('div[id="resultadoExistencias"]').toggleClass('sk-loading');
                                        //debugger;
                                    }).complete(function (){
                                        $('div[id="resultadoExistencias"]').toggleClass('sk-loading');
                                    });

                                }

                    });
            })

            $("#btnModalSelecionaExistencias").click(
                function () {

                    var selected = [];
                    $('input[name="Selecciona"').each(function () {
                        if ($(this).is(":checked")) {

                            var existencia = FindExistencia(this);
                            selected.push(existencia);
                        }
                    });

                    //debugger;
                    //valida que solo se seleccione un lote del almacen
                    var msg=$("#msgModal");
                    msgModalInit(msg);


                    if(selected.length==0)
                    {

                        $(msg).html('Seleccione un Lote');
                        $(msg).addClass('text-danger');
                        return false;
                    }

                    var form = $('#formlotes');
                    $(form ).validate();
                    var result=$(form).valid()
                    if(result!=true)
                    {
                        return false;
                    }

                    //if(selected.length>1)
                    //{

                    //    $(msg).html('Solamente se puede seleccionar un Lote');
                    //    $(msg).addClass('text-danger');
                    //    return false;
                    //}

                    var listasustancias = [];

                    var tabla = $("#tablaListado");


                    if ($(tabla).length > 0) {
                        if (listasustancias.length == 0) {
                            $(tabla).find("tr").each(function (key, value) {
                                //debugger
                                var sustanciam = FindModel(value, key)
                                if (sustanciam != null) {
                                    listasustancias.push(sustanciam);

                                }
                            })
                        }
                        else {
                            $.each(listasustancias, function (key, value) {
                                SetModel(value, key)
                            });

                        }
                    }


                    var url = $(this).attr('data-actionurl');

                    if (url.length > 0) {

                        $('#loading').toggleClass('sk-loading');

                        $.post(url, { selecionados: selected, sustancias: listasustancias })
                            .success(
                                function (result) {

                                    if (result !== null) {

                                        $('div[id="ListaSolicitud"]').html(result);

                                    }
                                    else {

                                        $("#lblInformacionModal").html("");
                                    }

                                    var form=$('div[id="ListaSolicitud"]').closest("form");

                                    $(form).data('validator', null);
                                    $.validator.unobtrusive.parse($(form));

                                    $('#loading').toggleClass('sk-loading');

                                }
                            )
                            //.fail(function () {
                            //    debugger
                            //    //$("#lblInformacionModal").html("Error al conectarse");
                            //    $('.ibox-content').toggleClass('sk-loading');
                            //});
                        .error(function (jqXHR, textStatus, errorThrown) {
                            $('#loading').toggleClass('sk-loading');
                            //debugger
                        });


                    } else {
                        $("#lblInformacionModal").html("Complete todos los campos");
                    }
                })


            $("#btnModalFirma").click(
                    function () {
                        //debugger;
                        var userName=$('input[id="UserName"]');

                        var clv=$('input[id="Password"]');

                        userName.closest('.form-group').removeClass('has-success').removeClass('has-error');
                        clv.closest('.form-group').removeClass('has-success').removeClass('has-error');

                        // Checa si ingresa un usuario
                        if(!userName.val()) {
                            // Add error
                            userName.closest('.form-group').removeClass('has-success').addClass('has-error');
                            return false;
                        }

                        if(!clv.val()) {
                            // Add error
                            clv.closest('.form-group').removeClass('has-success').addClass('has-error');
                            return false;
                        }

                        userName.closest('.form-group').removeClass('has-success').removeClass('has-error');
                        clv.closest('.form-group').removeClass('has-success').removeClass('has-error');
                        $('div[id="msgErrorFirma"]').removeClass('hidden');

                        var usr=$(UserName).val();
                        var pw=$(clv).val();

                        var url = $(this).attr('data-actionurl');

                        var urlFirmarUsuario='@Url.Action("FirmarUsuario", "DatosAplicacion")';

                        var idSolicitante=$('input[id="idSolicitante"]').val();


                        $('#loading').toggleClass('sk-loading');

                        $.post(urlFirmarUsuario, { usuario: usr, password: pw })
                                .success(
                                    function (result) {
                                        if (result.id !=null) {
                                            $('span[id="msgFirmaSolicitante"]').removeClass('text-danger');
                                            if(idSolicitante===result.id)
                                            {
                                                $('input[id="FirmaSolicitante"]').val(result.id);
                                                $('span[id="msgFirmaSolicitante"]').html(result.NombreCompleto);
                                                $('div[id="msgErrorFirma"]').addClass('hidden');

                                            }
                                            else{
                                                $('input[id="FirmaSolicitante"]').val("");
                                                $('span[id="msgFirmaSolicitante"]').html("El usuario ingresado no corresponde con el solicitante");

                                                $('span[id="msgFirmaSolicitante"]').addClass('text-danger');

                                            }
                                        }
                                        else {
                                            $('input[id="FirmaSolicitante"]').val("");
                                            $('span[id="msgFirmaSolicitante"]').html("El usuario ingresado no existe");

                                            $('span[id="msgFirmaSolicitante"]').addClass('text-danger');
                                        }
                                        $('#loading').toggleClass('sk-loading');
                                    }
                                )
                            .error(function (jqXHR, textStatus, errorThrown) {
                                $('#loading').toggleClass('sk-loading');
                                debugger;
                            })
                    })

    });

        function FindModel(object, row) {
            //debugger
            var result = null;

            var material=@Html.Raw(Json.Encode(new SolicitudDetalleVM()));

            var input = $('input[name="Materiales[' + row + '].idSustanciaMaterial"]');

            if ($(input).length > 0) {


                material.idSolicitudDetalle= $('input[name="Materiales[' + row + '].idSolicitudDetalle"]').val();
                material.idSustanciaMaterial= $('input[name="Materiales[' + row + '].idSustanciaMaterial"]').val();
                material.Descripcion= $('input[name="Materiales[' + row + '].Descripcion"]').val();
                material.CantidadSolicitada= $('input[name="Materiales[' + row + '].CantidadSolicitada"]').val();
                material.CantidadAutorizada= $('input[name="Materiales[' + row + '].CantidadAutorizada"]').val();
                material.CantidadSurtida= $('input[name="Materiales[' + row + '].CantidadSurtida"]').val();
                material.CantidadDevolver= $('input[name="Materiales[' + row + '].CantidadDevolver"]').val();
                material.CantidadDevuelta= $('input[name="Materiales[' + row + '].CantidadDevuelta"]').val();
                material.TotalSurtida= $('input[name="Materiales[' + row + '].TotalSurtida"]').val();//cambio

                material.idSolicitudEstatus = $('input[name="Materiales[' + row + '].idSolicitudEstatus"]').val();
                material.idSolicitudDetalleEstatus = $('input[name="Materiales[' + row + '].idSolicitudDetalleEstatus"]').val();
                material.idTipoEnvase= $('input[name="Materiales[' + row + '].idTipoEnvase"]').val();
                material.idPresentacion= $('input[name="Materiales[' + row + '].idPresentacion"]').val();
                material.idUnidadMedida= $('input[name="Materiales[' + row + '].idUnidadMedida"]').val();
                material.idAlmacen = $('input[name="Materiales[' + row + '].idAlmacen"]').val();
                material.Existencia = $('input[name="Materiales[' + row + '].Existencia"]').val();
                material.idCategoria= $('input[name="Materiales[' + row + '].idCategoria"]').val();

                material.index= $('input[name="Materiales[' + row + '].index"]').val();

                if(!$.isNumeric(material.CantidadSolicitada))material.CantidadSolicitada=0;
                if(!$.isNumeric(material.CantidadAutorizada))material.CantidadAutorizada=0;
                if(!$.isNumeric(material.CantidadSurtida))material.CantidadSurtida=0;
                if(!$.isNumeric(material.CantidadDevolver))material.CantidadDevolver=0;
                if(!$.isNumeric(material.CantidadDevuelta))material.CantidadDevuelta=0;

                var listalotes = []; //cambio

                var tabla = $("#tablaListado");

                $(tabla).find("tr").each(function (key, value) {



                    var input1 = $('input[name="Materiales[' + row + '].tSolicitudDetalleLote[' + key + '].idSustanciaMaterial"]');

                    if ($(input1).length > 0) {

                        var almacen = @Html.Raw(Json.Encode(new SolicitudDetalleLoteVM()));

                        almacen.idAlmacen = $('input[name="Materiales[' + row + '].tSolicitudDetalleLote[' + key + '].idAlmacen"]').val();
                        almacen.idSustanciaMaterial=$('input[name="Materiales[' + row + '].tSolicitudDetalleLote[' + key + '].idSustanciaMaterial"]').val();
                        almacen.Existencia=$('input[name="Materiales[' + row + '].tSolicitudDetalleLote[' + key + '].Existencia"]').val();
                        almacen.CantidadSurtida=$('input[name="Materiales[' + row + '].tSolicitudDetalleLote[' + key + '].CantidadSurtida"]').val();
                        almacen.CantidadDevolver=$('input[name="Materiales[' + row + '].tSolicitudDetalleLote[' + key + '].CantidadDevolver"]').val();

                        if (!$.isNumeric(almacen.Existencia)) almacen.Existencia = 0;
                        if (!$.isNumeric(almacen.CantidadSurtida)) almacen.CantidadSurtida = 0;
                        if (!$.isNumeric(almacen.CantidadDevolver)) almacen.CantidadDevolver = 0;

                        listalotes.push(almacen);
                    }


                })


                material.tSolicitudDetalleLote=listalotes;

                result = material;
            }



            return result;
        }

        function SetModel(material, row) {

            var result = null;



            var input = $('input[name="Materiales[' + row + '].CantidadSolicitada"]');

            if ($(input).length > 0) {


                material.CantidadSolicitada= $('input[name="Materiales[' + row + '].CantidadSolicitada"]').val();
                material.CantidadAutorizada= $('input[name="Materiales[' + row + '].CantidadAutorizada"]').val();
                material.CantidadSurtida= $('input[name="Materiales[' + row + '].CantidadSurtida"]').val();
                material.CantidadDevolver= $('input[name="Materiales[' + row + '].CantidadDevolver"]').val();
                material.CantidadDevuelta= $('input[name="Materiales[' + row + '].CantidadDevuelta"]').val();

                if(!$.isNumeric(material.CantidadSolicitada))material.CantidadSolicitada=0;
                if(!$.isNumeric(material.CantidadAutorizada))material.CantidadAutorizada=0;
                if(!$.isNumeric(material.CantidadSurtida))material.CantidadSurtida=0;
                if(!$.isNumeric(material.CantidadDevolver))material.CantidadDevolver=0;
                if(!$.isNumeric(material.CantidadDevuelta))material.CantidadDevuelta=0;


                result = material;
            }



            return result;
        }

        function FindExistencia(object) { //cambio

            var result = null;

            var almacen = @Html.Raw(Json.Encode(new SolicitudDetalleLoteVM()));


            if ($(object).length > 0) {

                var indice=$(object).attr('data-indice');
                var CantidadSurtida=$('input[name="surtir_' + indice + '"]').val();
                var CantidadDevolver=$('input[name="devolver_' + indice + '"]').val();

                almacen.idAlmacen = $(object).val();
                almacen.idSustanciaMaterial = $(object).attr('data-idSustanciaMaterial');
                almacen.Existencia = $(object).attr('data-Existencia');

                almacen.CantidadSurtida = CantidadSurtida;
                almacen.CantidadDevolver = CantidadDevolver;
                //almacen.CantidadDevuelta = 0;

                if (!$.isNumeric(almacen.Existencia)) almacen.Existencia = 0;
                if (!$.isNumeric(almacen.CantidadSurtida)) almacen.CantidadSurtida = 0;
                if (!$.isNumeric(almacen.CantidadDevolver)) almacen.CantidadDevolver = 0;

                result = almacen;
            }

            return result;
        }

        function msgModalInit(msg){
            $(msg).html('');
            $(msg).removeClass('text-danger');
        }

        //validaciones de los lotes

        $("#formlotes").validate({ //cambio
            errorClass: "text-danger"
        });

</script>
