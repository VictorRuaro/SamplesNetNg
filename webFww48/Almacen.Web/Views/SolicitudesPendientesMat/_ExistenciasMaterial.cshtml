@using Almacen.Web.ViewModels

@model IEnumerable<AlmacenMaterialVM>

<div class="panel panel-default">
    <div class="table-responsive">

        <table class="table table-hover table-condensed " id="table">
            <thead class="">
                <tr>
                    <th>
                        <span class="text-purple">Selecciona</span>
                    </th>
                    <th>
                        <span class="text-purple">Cantidad Utilizar</span>
                    </th>
                    <th>
                        <span class="text-purple">Cantidad Devolver</span>
                    </th>
                    <th class="">@Html.DisplayNameFor(model => model.LoteInterno)</th>
                    <th class="">@Html.DisplayNameFor(model => model.cPresentacion.Presentacion)</th>
                    <th class="">@Html.DisplayNameFor(model => model.Existencia)</th>
                    <th class="">@Html.DisplayNameFor(model => model.FechaRecepcion)</th>
                    <th class="">@Html.DisplayNameFor(model => model.FechaCaducidad)</th>
                    <th class="">@Html.DisplayNameFor(model => model.cMarca.Marca)</th>
                    <th class="">@Html.DisplayNameFor(model => model.cProveedor.Proveedor)</th>
                    <th class="">@Html.DisplayNameFor(model => model.LoteProveedor)</th>
                    <th class="">@Html.DisplayNameFor(model => model.NumParte)</th>
                    <th class="">@Html.DisplayNameFor(model => model.NumCatalago)</th>
                    <th class="">@Html.DisplayNameFor(model => model.cCondicionesAlmacenaje.CondicionesAlmacenaje)</th>
                </tr>
            </thead>

            <tbody class="h6">
                @if (Model == null)
                {
                    <tr>
                        <td colspan="12">
                            <div class="alert alert-warning"><i class="fa fa-warning mr"></i><strong>No se han ingresado datos</strong></div>
                        </td>
                    </tr>

                }
                else if (Model.Count() == 0)
                {
                    <tr>
                        <td colspan="12">
                            <div class="alert alert-info"><i class="fa fa-warning mr"></i><strong>No se encontraron existencias</strong></div>
                        </td>
                    </tr>
                }
                else
                {
                    int indicex = 0;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="td-actions text-center">

                                <div class="checkbox c-checkbox">
                                    <label>
                                        <input name="Selecciona" id="Selecciona" type="checkbox"
                                               value="@item.idAlmacen"
                                               data-idSustanciaMaterial="@item.idSustanciaMaterial"
                                               data-Existencia="@item.Existencia"
                                               data-indice="@indicex">
                                        <span class="fa fa-check bg-white"></span>
                                    </label>
                                </div>
                            </td>
                            <td class="">
                                <input type="hidden"
                                       id="@(indicex)__existencia"
                                       name="existencia_@indicex"
                                       value="@item.Existencia" />

                                <input type="number"
                                       id="@(indicex)__surtir"
                                       name="surtir_@indicex"
                                       class="form-control text-box single-line input-sm validasurtir"
                                       data-msg-valuecomparison="Debe ser menor o igual a la Existencia"
                                       value="@item.Existencia" />

                            </td>
                            <td class="">
                                <input type="number"
                                       id="@(indicex)__devolver"
                                       name="devolver_@indicex"
                                       class="form-control text-box single-line input-sm validadevolver"
                                       data-val-valuecomparison="Debe ser menor o igual a la Cantidad Surtir"
                                       value="0" />

                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.LoteInterno)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cPresentacion.Presentacion)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.Existencia)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.FechaRecepcion)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.FechaCaducidad)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cMarca.Marca)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cProveedor.Proveedor)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.LoteProveedor)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.NumParte)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.NumCatalago)
                            </td>
                            <td class="">
                                @Html.DisplayFor(modelItem => item.cCondicionesAlmacenaje.CondicionesAlmacenaje)
                            </td>
                        </tr>
                        indicex++;
                    }
                }
            </tbody>
        </table>

    </div>

</div>
<script type="text/javascript">
    $('.validasurtir').each(function () {
        
            $(this).rules('add', {
                required: true,
                range:[1,99999],
                valuecomparison: { property: 'existencia', comparison: 'IsLessThanOrEqual', notvalidatewhenvalue: '0' },
                messages:
                {
                    required:"Requerido",
                    range:"Minimo de {0} y maximo {1}",
                    valuecomparison: "Debe ser menor o igual a la Existencia"
                }
            });
});

$('.validadevolver').each(function () {
    $(this).rules('add', {
        required: true,
        range: [0, 99999],
        valuecomparison: { property: 'surtir', comparison: 'IsLessThan', notvalidatewhenvalue: '0' },
        messages:
        {
            required: "Requerido",
            range: "Minimo de {0} y maximo {1}",
            valuecomparison: "Debe ser menor a la Cantidad Utilizar"
        }
    });
});
</script>