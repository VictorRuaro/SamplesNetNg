@using Almacen.Web.ViewModels
@using Almacen.Web.ViewModels.Catalogos

@model BaseListaCatalogosVM<SolicitudVM>

<h3>Solicitudes de Materiales</h3>
@using (Html.BeginForm())
{
    Html.RenderPartial("_buscadorSolicitud", ViewBag.SolicitudFiltros as SolicitudFiltrosVM);


    <div class="mb-lg">

    </div>
    if (Model.SinDatosListado)
    {
        <tr>
            <td colspan="8">
                <div class="alert alert-warning"><i class="fa fa-warning mr"></i><strong>No se han ingresado solicitudes</strong></div>
            </td>
        </tr>
    }
    else
    {
        Html.RenderPartial("_ListaSolicitudes", Model.Paginacion.Lista);


        Html.RenderPartial("_paginador", Model.Paginador);
    }
}