@using Almacen.Web.ViewModels
@using Almacen.Web.Aplicacion
@using Almacen.Web.ViewModels.Catalogos

@model IEnumerable<SolicitudVM>

<div class="panel panel-default">
    <div class="table-responsive">
        <table class="table">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Folio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Descripcion)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DescripcionUso)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.idSolicitante)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.idAutorizador)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FechaAutoriza)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.idEstatusSolicitud)
                </th>
                <th></th>
            </tr>
            @if (Model == null)
            {
            <tr>
                <td colspan="8">
                    <div class="alert alert-warning"><i class="fa fa-warning mr"></i><strong>No se han ingresado datos</strong></div>
                </td>
            </tr>

            }
            else if (Model.Count() == 0)
            {
            <tr>
                <td colspan="8">
                    <div class="alert alert-info"><i class="fa fa-warning mr"></i><strong>No se encontraron solicitudes pendientes de Surtir</strong></div>
                </td>
            </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    item.SolicitudEditable = (item.cEstatusSolicitud.NumEstatus < (int)EnumEstatus.PorAutorizar);

                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Folio)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Descripcion)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DescripcionUso)
                        </td>
                        <td>
                            @*@Html.DisplayFor(modelItem => item.Solicitante.NombreCompleto)*@
                            <div class="">
                                
                                    @Html.Action("DatosUsuario", "DatosAplicacion", new { IdUsuario = item.idSolicitante })
                                        
                            </div>
                        </td>
                        <td>
                            @*@Html.DisplayFor(modelItem => item.Solicitante.NombreCompleto)*@
                            <div class="">

                                @Html.Action("DatosUsuario", "DatosAplicacion", new { IdUsuario = item.idAutorizador })

                            </div>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.FechaAutoriza)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.cEstatusSolicitud.EstatusSolicitud)
                        </td>
                        <td>
                            @if (item.cEstatusSolicitud.NumEstatus == (int)EnumEstatus.Pendiente)
                            {
                                if (User.IsInRole(EnumRol.Administrador) || User.IsInRole(EnumRol.Administrador_Almacen))
                                {
                                    @Html.ActionLink("Surtir", "Surtir", new { id = item.idSolicitud }, new { @class = "btn btn-link" }) <span>|</span>
                                }
                                else
                                {
                                    <span class="text-muted ml-lg mr">Surtir</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted ml-lg mr">Surtir</span><span>|</span>
                            }
                            @Html.ActionLink("Detalle", "Details", new { id = item.idSolicitud }, new { @class = "btn btn-link" })
                            
                        </td>
                    </tr>
            }
        }

        </table>

    </div>
</div>