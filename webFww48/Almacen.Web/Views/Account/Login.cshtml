@using Almacen.Web.Models
@model LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<div class="block-center-side">
    <div class="block-center mt-xl wd-xl">
        <h3>@ViewBag.Title.</h3>
        <div class="panel panel-primary panel-flat shadow-z2">
            <div class="panel-heading text-center">
                <a href="#">
                    @*<img src="~/Content/Images/logo.png" alt="Image" class="block-center img-rounded" />*@
                    Usuario
                </a>

            </div>
            <div class="panel-body">
                <p class="text-center pv">Use una cuenta para iniciar sesión.</p>
                <section id="loginForm">
                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group has-feedback">
                            @*<label for="UserName" class="col-md-2 control-label">
                                    <span class="h5 text-primary">
                                        @Html.DisplayNameFor(m => m.UserName)
                                    </span>
                                </label>*@
                            @Html.LabelFor(m => m.UserName, new { @class = "col-md-3 control-label" })
                            <div class="col-md-9">
                                @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                                <span class="fa fa-user form-control-feedback text-muted"></span>
                                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group has-feedback">

                            @*<label for="Password" class="col-md-2 control-label">
                                    <span class="h5 text-primary">
                                        @Html.DisplayNameFor(m => m.Password)
                                    </span>
                                </label>*@
                            @Html.LabelFor(m => m.Password, new { @class = "col-md-3 control-label  mt0" })
                            <div class="col-md-9">

                                @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                                <span class="fa fa-lock form-control-feedback text-muted"></span>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-offset-4 col-md-10">
                                <div class="">
                                    @Html.CheckBoxFor(m => m.RememberMe)
                                    @Html.LabelFor(m => m.RememberMe, new {@class="text-primary" })
                                    @*<label for="RememberMe" class="">
                                            <span class="text-primary">
                                                @Html.DisplayNameFor(m => m.RememberMe)
                                            </span>
                                        </label>*@
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-12">
                                <input type="submit" value="Iniciar sesión" class="btn btn-block btn-primary" />
                            </div>
                        </div>
                        @*<p>
                                @Html.ActionLink("Registrar como nuevo usuario", "Register")
                            </p>*@
                        @* Habilite esta opción después de habilitar la confirmación de la cuenta para la función de restablecimiento de contraseña
                            <p>
                                @Html.ActionLink("¿Ha olvidado su contraseña?", "ForgotPassword")
                            </p>*@
    }
                </section>
            </div>
        </div>

    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}