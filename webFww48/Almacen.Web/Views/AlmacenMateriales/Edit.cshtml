    <a href="@Url.Action("Existencias", new { idSustanciaMaterial = Model.idSustanciaMaterial })" class="btn btn-default text-primary" title="Ir a Existencias">
        Ir a Existencias
    </a>
</div>

@section Styles {


    <link href="@Styles.Url("~/Content/bootstrap-datetimepicker.css")" rel="stylesheet" type="text/css" />
}
@section Scripts {

    @Scripts.Render("~/bundles/chosen")
    @Scripts.Render("~/bundles/moment")
    @Scripts.Render("~/bundles/datetimepicker")
<script type="text/javascript">
    $(function () {
        $.validator.methods.date = function (value, element) {
            return this.optional(element) || moment(value, 'DD/MM/YYYY', true).isValid();
        };
    });
        $(".chosen-select").chosen({ no_results_text: "Resultados no encontrados para:" });
</script>
}



