                                                                    @Html.HiddenFor(modelItem => Model.Materiales[i].index)

                                                                    @Html.HiddenFor(modelItem => Model.Materiales[i].idCategoria)
                                                                    @Html.HiddenFor(modelItem => Model.Materiales[i].idSolicitudDetalle)
                                                                    @Html.HiddenFor(modelItem => Model.Materiales[i].idSustanciaMaterial)
                                                                    @Html.HiddenFor(modelItem => Model.Materiales[i].Descripcion)
                                                                    @Html.HiddenFor(modelItem => Model.Materiales[i].idEstatusSolicitud)



                                                                    <div class="">
                                                                        @if (Model.idCategoria == (int)EnumCategoria.Sustancias)
                                                                        {
                                                                            @Html.Action("DatosSustancia", "DatosAplicacion", new { idSustanciaMaterial = Model.Materiales[i].idSustanciaMaterial })
                                                                        }
                                                                        else
                                                                        {
                                                                            @Html.Action("DatosMaterial", "DatosAplicacion", new { idSustanciaMaterial = Model.Materiales[i].idSustanciaMaterial })
                                                                        }
                                                                    </div>
                                                                </td>

                                                                <td class="">
                                                                    @Html.HiddenFor(modelItem => Model.Materiales[i].CantidadSolicitada)
                                                                    @Html.DisplayFor(modelItem => Model.Materiales[i].CantidadSolicitada)


                                                                </td>
                                                                <td class="">
                                                                    @Html.EditorFor(modelItem => Model.Materiales[i].CantidadAutorizada, "", new
                                                               {
                                                                   htmlAttributes = new
                                                                   {
                                                                       @class = "form-control",
                                                                   }
})

                                                                    @Html.ValidationMessageFor(modelItem => Model.Materiales[i].CantidadAutorizada, "", new
                                                               {
                                                                   @class = "text-danger"
                                                               })
                                                                </td>

                                                                <td class="">
                                                                    <input class="btn btn-link btnEliminarSustancia" type="button" value="Eliminar"
                                                                           data-actionurl="@Url.Action("ListaEliminarElemento", "SolicitudesAutorizarSus")"
                                                                           data-id="@Model.Materiales[i].index">
                                                                </td>

                                                            </tr>*@

                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                                            //Html.RenderPartial("_EditarSolicitudSustancias", Model.Materiales);
                                                        }
                                                        else
                                                        {
                                    <div class="well bg-gray-lighter"><i class="fa fa-warning mr text-warning"></i><span class="text-purple">No se han agregado materiales</span></div>
