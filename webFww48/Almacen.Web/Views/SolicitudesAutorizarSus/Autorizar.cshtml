                    </div>
                </div>


                <div class="form-group">
                    @Html.LabelFor(model => model.DescripcionUso, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <div class="bb p-sm">
                            @Html.HiddenFor(model => model.DescripcionUso)
                            @Html.Raw(Model.DescripcionUso ?? "&nbsp;")
                        </div>
                    </div>
                </div>
            </div>
            <div class="panel-footer bb0 pb0 ">
                <div class="form-group mb0">
                    @if (Model.ValidaFlujo.visibleBtnAutorizar)
                    {
                    <div class="col-md-offset-2 col-md-10">
                        <input name = "btnAccion" class="btn btn-primary" type="submit" value="Guardar">
                        <div class="pull-right">
                            <input name = "btnAccion" class="btn btn-success shadow-z1 pull-right" type="submit" value="Autorizar">
                        </div>
                    </div>
                    }
                </div>

            </div>
}
            <div class="panel-footer bt0 pt0 ">
                <div class="form-group mt0">
                    <div class="text-center">
                        <div class="clearfix">

                            @using(Html.BeginForm("RegresarSinEnviar", "SolicitudesAutorizarSus", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.idSolicitud)
                                @Html.HiddenFor(model => model.idEstatusSolicitud)
                                @Html.HiddenFor(model => model.UG)
                                @Html.HiddenFor(model => model.Folio)
                                if (Model.ValidaFlujo.visibleBtnRegresarSinEnviar)
                                {
                                    <button type = "submit" class="btn btn-default shadow-z1">
                                        <i class="fa fa-repeat"></i> Rechazar
                                    </button>

                                }

                            }


                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<div>
    <a href = "@Url.Action("Index")" class="btn btn-default text-primary" title="Regresar">
        <i class="fa fa-arrow-left"></i> Regresar
    </a>
</div>

@section BodyArea
